# ── Server ────────────────────────────────────────────────────
PORT=9000

# ── Primary CSMS (required) ──────────────────────────────────
# All charger messages are forwarded here, and all responses
# from this CSMS are relayed back to the charger.
PRIMARY_CSMS_URL=wss://your-primary-csms.example.com/ocpp

# ── Secondary / mirror CSMS (optional) ───────────────────────
# Comma-separated list of additional CSMS endpoints.
# Charger messages are mirrored to these backends, but their
# responses are NOT sent back to the charger.
# SECONDARY_CSMS_URLS=wss://secondary-a.example.com/ocpp,wss://secondary-b.example.com/ocpp

# ── Logging ───────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# LOG_DEBUG_MESSAGE_MAX_LENGTH=120

# ── Persistent Storage ─────────────────────────────────────────
# Path to directory where disk-based queues and session state are persisted.
# QUEUE_DIR=/app/queue

# ── Command Filtering (Stealth Rejection) ──────────────────────
# Comma-separated list of downstream OCPP action names from the Primary CSMS
# to block. When set, the proxy stealthily responds with OCPP rejection
# frames without forwarding the action to the physical charger.
# Defaults to empty (nothing blocked).
# BLOCKED_CSMS_ACTIONS=ChangeConfiguration,UpdateFirmware

# ── Charge Point ID URL Appending ──────────────────────────────
# Automatically append the extracted charge point ID to upstream URLs.
# PRIMARY_CSMS_APPEND_CHARGE_POINT_ID=true
# SECONDARY_CSMS_APPEND_CHARGE_POINT_ID=true
